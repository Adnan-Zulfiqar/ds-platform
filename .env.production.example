# DropPilot AI — production environment template.
#
# Copy to your secret manager, NOT to a file on the server. Every value below
# marked REQUIRED must be set or the application refuses to start; that refusal
# is deliberate and is tested (`tests/unit/test_security_hardening.py`).
#
# This file contains no real values and never should. It is committed so that a
# deployment has a checklist; `.env` itself is gitignored.
#
# Differences from `.env.example`, which targets local development:
#   * every secret here is REQUIRED — there are no working defaults
#   * ENVIRONMENT=production activates startup validation
#   * ALLOWED_HOSTS may not be a wildcard
#   * SECURITY_COOKIE_SECURE may not be false
#   * LOG_INCLUDE_REQUEST_BODY may not be true

# ---------------------------------------------------------------------------
# Environment
# ---------------------------------------------------------------------------
# REQUIRED. `production` or `staging` both enable the deployed-environment
# guards. Leaving this at `local` in production silently disables every check
# below, which is the most dangerous single mistake available here.
ENVIRONMENT=production

PROJECT_NAME=DropPilot AI
API_V1_PREFIX=/api/v1

# REQUIRED. A wildcard is rejected at startup: it permits Host header attacks,
# which turn into poisoned password-reset links.
ALLOWED_HOSTS=app.droppilot.ai,api.droppilot.ai

# REQUIRED. The browser origins allowed to call the API. Not a wildcard — the
# API sends credentials, and browsers reject `*` in that case anyway.
CORS_ORIGINS=https://app.droppilot.ai

# ---------------------------------------------------------------------------
# Secrets — every one REQUIRED, none with a default
# ---------------------------------------------------------------------------
# Signs every JWT. Minimum 32 characters, enforced in every environment
# (RFC 7518 §3.2 for HS256). Startup refuses the shipped placeholder.
#
#   openssl rand -base64 48
SECURITY_SECRET_KEY=

# Encrypts stored supplier credentials. Comma-separated, NEWEST FIRST.
# Decryption tries every key; encryption uses the first — that is what makes
# rotation possible without downtime.
#
# Startup refuses: an empty value, any key published in this repository's test
# suite, and any value equal to SECURITY_SECRET_KEY. The last one matters
# because the two are rotated on different schedules: a signing key can be
# replaced immediately at the cost of ending every session, an encryption key
# cannot until stored ciphertext is re-encrypted.
#
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
SECURITY_ENCRYPTION_KEYS=

# REQUIRED. Compose refuses to start without these rather than substituting the
# value published in this repository.
POSTGRES_PASSWORD=
RABBITMQ_PASSWORD=

# ---------------------------------------------------------------------------
# Session and cookie security
# ---------------------------------------------------------------------------
# Must be true. The refresh cookie is the longest-lived credential a browser
# holds; without Secure it travels over plain HTTP where anyone on the path can
# lift it and mint access tokens for its full life. Startup refuses false.
SECURITY_COOKIE_SECURE=true

# `strict` breaks the OAuth return journey (the browser arrives from AliExpress
# or Shopify), so `lax` is the correct choice rather than the lazy one.
SECURITY_COOKIE_SAMESITE=lax

SECURITY_ACCESS_TOKEN_TTL_MINUTES=15
SECURITY_REFRESH_TOKEN_TTL_DAYS=30

# ---------------------------------------------------------------------------
# Data stores
# ---------------------------------------------------------------------------
POSTGRES_HOST=
POSTGRES_PORT=5432
POSTGRES_USER=droppilot
POSTGRES_DB=droppilot

REDIS_HOST=
REDIS_PORT=6379
REDIS_PASSWORD=

RABBITMQ_USER=droppilot

# ---------------------------------------------------------------------------
# Suppliers and channels
# ---------------------------------------------------------------------------
# The developer application belongs to the platform operator, not to a tenant.
ALIEXPRESS_APP_KEY=
ALIEXPRESS_APP_SECRET=
ALIEXPRESS_CALLBACK_URL=https://api.droppilot.ai/api/v1/integrations/aliexpress/callback
ALIEXPRESS_ENVIRONMENT=production

SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=

# ---------------------------------------------------------------------------
# Observability
# ---------------------------------------------------------------------------
LOG_LEVEL=INFO
LOG_JSON_OUTPUT=true

# Must be false. Request bodies carry customer data. Startup refuses true.
LOG_INCLUDE_REQUEST_BODY=false

# ---------------------------------------------------------------------------
# Frontend build argument
# ---------------------------------------------------------------------------
# Inlined into the client bundle at build time, so it must never hold a secret.
NEXT_PUBLIC_API_URL=https://api.droppilot.ai
