# DropPilot AI — frontend environment
#
# Copy to .env.local for local development. .env.local is gitignored.
#
# WARNING: every NEXT_PUBLIC_* variable is inlined into the JavaScript bundle at
# build time and is therefore visible to anyone who opens devtools. Never put a
# secret here — API keys, tokens, database URLs belong in the backend only.

# Base URL of the backend API, without a trailing slash.
# The client appends /api/v1 itself.
# Prefer 127.0.0.1 over localhost on Windows: browsers often resolve localhost
# to ::1 while Uvicorn may listen on IPv4 only, which surfaces as
# "Could not reach the server" on registration/login.
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000

# Request timeout in milliseconds.
NEXT_PUBLIC_API_TIMEOUT_MS=30000

# Display name, used in titles and the sidebar.
NEXT_PUBLIC_APP_NAME=DropPilot AI

# One of: local | test | staging | production
NEXT_PUBLIC_ENVIRONMENT=local
