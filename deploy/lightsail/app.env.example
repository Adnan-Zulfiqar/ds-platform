# DropPilot AI — Lightsail deployment environment.
#
# **TEMPLATE. Every value below is a placeholder.** Copy to /etc/droppilot/app.env
# on the instance, fill it in, and never copy it back:
#
#     install -d -m 700 -o root -g root /etc/droppilot
#     install -m 600 -o root -g root app.env.example /etc/droppilot/app.env
#
# Directory 700, files 600, both root-owned. `scripts/deploy/preflight.sh`
# refuses to deploy if either is looser, because a secret file the whole
# instance can read is a secret every process on it has — including anything
# that gets a shell through the application.
#
# ---------------------------------------------------------------------------
# Where secrets must never go
# ---------------------------------------------------------------------------
#
# * **Not in Git.** This directory is outside the checkout. Preflight asserts no
#   deployment env file is tracked.
# * **Not in a Compose file.** `docker/compose.lightsail.yml` names variables;
#   it holds no values.
# * **Not in an image.** Nothing here is a build argument. `docker history` on a
#   built image shows no value from this file.
# * **Not in a command line.** A command line is readable by every user on the
#   host via /proc. Compose passes this file to the container's environment.
# * **Not in a systemd unit.** The unit references the file; `systemctl show`
#   does not render EnvironmentFile contents.
# * **Never in a NEXT_PUBLIC_* variable.** Those are inlined into the client
#   bundle and shipped to every browser. There is exactly one Google value the
#   frontend needs and it is a public client ID.

# ---------------------------------------------------------------------------
# Environment
# ---------------------------------------------------------------------------
# `local` here is refused by PROD-H1: every deployed guard in the application is
# conditional on this value, so `local` on a public host switches all of them
# off while everything still appears to work.
ENVIRONMENT=production

ALLOWED_HOSTS=api.whiteto.com
CORS_ORIGINS=https://app.whiteto.com

# ---------------------------------------------------------------------------
# Lightsail Managed PostgreSQL — private access only
# ---------------------------------------------------------------------------
# The endpoint of the managed database. Private networking must be enabled and
# public mode disabled in the Lightsail console; a publicly-reachable managed
# database is on the internet with only a password in front of it.
POSTGRES_HOST=CHANGE-ME.CHANGE-ME.eu-west-2.rds.amazonaws.com
POSTGRES_PORT=5432
POSTGRES_DB=droppilot
POSTGRES_USER=CHANGE-ME
POSTGRES_PASSWORD=CHANGE-ME

# `require` encrypts the connection but never checks who answered. `verify-full`
# checks the certificate chain *and* that the hostname matches — the difference
# is an attacker who can redirect traffic. PROD-H1 refuses anything weaker.
POSTGRES_SSLMODE=verify-full
# The regional AWS CA bundle, mounted read-only into the containers. Download
# from https://truststore.pki.rds.amazonaws.com/eu-west-2/eu-west-2-bundle.pem
# and place at /etc/droppilot/tls/rds-ca-eu-west-2.pem.
POSTGRES_SSLROOTCERT=/etc/droppilot/tls/rds-ca-eu-west-2.pem

# Pool sizing. The effective connection count is
# (pool_size + max_overflow) x process_count, and it must stay under the managed
# plan's max_connections with headroom for the migration and ops containers.
# A 2 GB Lightsail database allows roughly 200; backend + worker + beat at these
# values reach 45.
POSTGRES_POOL_SIZE=10
POSTGRES_MAX_OVERFLOW=5

# ---------------------------------------------------------------------------
# Security keys — generate on the operator's machine, never reuse
# ---------------------------------------------------------------------------
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECURITY_SECRET_KEY=CHANGE-ME-at-least-32-characters-and-unique

#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# Must differ from SECURITY_SECRET_KEY. One leak would otherwise compromise both
# and neither could be rotated without the other.
SECURITY_OTP_HMAC_KEY=CHANGE-ME-distinct-from-the-signing-key

#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Comma-separated, newest first. Decryption tries every key; encryption uses the
# first. That is what makes rotation possible without re-encrypting first.
SECURITY_ENCRYPTION_KEYS=

SECURITY_COOKIE_SECURE=true
# The Cloudflare connector's address on the edge network. Without this the
# application sees every request as coming from the tunnel and rate limiting
# collapses to one bucket for the whole internet.
SECURITY_TRUSTED_PROXIES=172.16.0.0/12

# ---------------------------------------------------------------------------
# Broker and cache
# ---------------------------------------------------------------------------
RABBITMQ_USER=droppilot
RABBITMQ_PASSWORD=CHANGE-ME

# ---------------------------------------------------------------------------
# Google Identity Services
# ---------------------------------------------------------------------------
# The client ID is **public** — it is embedded in every page that renders the
# sign-in button. It is configuration, not a credential.
#
# There is deliberately no client *secret*. The implementation verifies an ID
# token issued to the browser; it never exchanges an authorization code, so a
# secret would be an unused credential sitting in a file, which is a liability
# rather than a control. Adding one is a change of flow, not a change of config.
GOOGLE_OAUTH_CLIENT_ID=CHANGE-ME.apps.googleusercontent.com
# Must equal the value above. It is inlined into the client bundle at BUILD
# time by scripts/deploy/build_images.sh, so setting it here changes nothing at
# runtime — it is recorded so the two can be compared.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=CHANGE-ME.apps.googleusercontent.com

# ---------------------------------------------------------------------------
# Resend — transactional email
# ---------------------------------------------------------------------------
# `stub` generates reset codes without delivering them. Switching to `resend`
# begins sending real email to real people and is a separately authorised step.
EMAIL_PROVIDER=stub
RESEND_API_KEY=CHANGE-ME
# The verified sending domain. Mail from any other domain will be rejected or
# land in spam, and DMARC alignment is what makes the difference.
EMAIL_FROM=security@auth.whiteto.com
# Track E3: the public web origin; links in notification emails point here.
EMAIL_APP_BASE_URL=https://CHANGE-ME.example.com

# ---------------------------------------------------------------------------
# Browser-facing URLs — inlined at BUILD time
# ---------------------------------------------------------------------------
# Changing these requires rebuilding the frontend image. They are listed here so
# the readiness audit can check them, not because the running container reads
# them.
NEXT_PUBLIC_API_URL=https://api.whiteto.com
SHOPIFY_FRONTEND_RETURN_URL=https://app.whiteto.com/settings/integrations
# Track E7 W4b: public https base for WooCommerce order webhooks.
WOOCOMMERCE_WEBHOOK_CALLBACK_BASE=https://CHANGE-ME.example.com/api/v1/integrations/woocommerce/webhooks
# Track E5: operator networks for /api/v1/platform/*. Empty keeps the
# platform admin panel switched off.
PLATFORM_ADMIN_ALLOWED_CIDRS=
# Track E6: Stripe billing. Secrets: set in the real .env only, never here.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Free days for every new workspace (once per store, see docs/track-e/E6_BILLING.md).
STRIPE_TRIAL_DAYS=30
ALIEXPRESS_FRONTEND_RETURN_URL=https://app.whiteto.com/settings/integrations
EBAY_FRONTEND_RETURN_URL=https://app.whiteto.com/settings/integrations

# ---------------------------------------------------------------------------
# Marketplace credentials
# ---------------------------------------------------------------------------
EBAY_CLIENT_ID=CHANGE-ME
EBAY_CLIENT_SECRET=CHANGE-ME
EBAY_REDIRECT_URI_NAME=CHANGE-ME
# Blank: the scanner refuses any template-committed value for these two, since
# a template with a real key in it stops being a template. Fill in on the
# operator's machine only.
SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=
ALIEXPRESS_APP_KEY=CHANGE-ME
ALIEXPRESS_APP_SECRET=
# Platform dropshipper token for product import without merchant OAuth
# (docs/ALIEXPRESS_INTEGRATION.md). Secret: set on the server only.
ALIEXPRESS_CATALOG_ACCESS_TOKEN=

# ---------------------------------------------------------------------------
# Logging
# ---------------------------------------------------------------------------
LOG_LEVEL=INFO
LOG_JSON_OUTPUT=true
# Request bodies carry passwords, OTP codes and customer data. Never true.
LOG_INCLUDE_REQUEST_BODY=false

# ---------------------------------------------------------------------------
# Backups — NOT ACTIVE
# ---------------------------------------------------------------------------
# Left unset deliberately. Setting these does not start taking backups; the
# `backup` Compose profile and the systemd timer are both uninstalled. Turning
# the regime on needs the key generated into a secret store, an off-site
# destination chosen, a retention period agreed and a restore drill performed
# from a real production backup. Until then PROD-H1 reports BACKUPS as BLOCKED,
# and that is the correct answer.
#
# BACKUP_ENCRYPTION_KEY=
# BACKUP_DIRECTORY=/var/backups/droppilot
# BACKUP_OFFSITE_DESTINATION=
# AWS_PROFILE=
