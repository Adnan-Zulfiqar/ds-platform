# DropPilot AI — root environment file.
#
# Copy to .env for Docker Compose:  cp .env.example .env
#
# Compose reads this for variable substitution AND passes it to the backend and
# worker containers via `env_file`. The frontend does not read it — its
# NEXT_PUBLIC_* values are build arguments, because Next.js inlines them at
# build time (see frontend/.env.example).
#
# .env is gitignored. Never commit real credentials.

# ---------------------------------------------------------------------------
# Environment
# ---------------------------------------------------------------------------
# One of: local | test | staging | production
#
# Deployed values (staging, production) make the application refuse to start
# with a placeholder secret key or a wildcard host, so these are not cosmetic.
ENVIRONMENT=local

PROJECT_NAME=DropPilot AI
API_V1_PREFIX=/api/v1

# Comma-separated. Must list explicit origins rather than "*", because the API
# sends credentials and browsers reject a wildcard in that case.
# Include both the direct Next port and the nginx public origin (audit A-05).
CORS_ORIGINS=http://localhost:3000,http://localhost

# Comma-separated. "*" is rejected outright in deployed environments — it
# permits Host header attacks.
ALLOWED_HOSTS=*

DEFAULT_PAGE_SIZE=25
MAX_PAGE_SIZE=100

# ---------------------------------------------------------------------------
# PostgreSQL
# ---------------------------------------------------------------------------
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=droppilot
POSTGRES_PASSWORD=droppilot
POSTGRES_DB=droppilot
# Integration tests use an isolated database (see tests/integration/conftest.py).
# POSTGRES_TEST_DB=droppilot_test

# Optional fallback AliExpress ship-to (ISO 3166-1 alpha-2). Leave blank so the
# Import dialog / store settings / last successful import supply the destination
# instead of silently defaulting every merchant to US.
# DEFAULT_SHIP_TO_COUNTRY=

# Effective connections against Postgres are
# (POOL_SIZE + MAX_OVERFLOW) x process count. Keep that below the server's
# max_connections, or put PgBouncer in front.
POSTGRES_POOL_SIZE=20
POSTGRES_MAX_OVERFLOW=10
POSTGRES_POOL_TIMEOUT=30
POSTGRES_POOL_RECYCLE=1800
POSTGRES_POOL_PRE_PING=true

# Logs every statement. Useful when debugging a query, far too noisy otherwise.
POSTGRES_ECHO_SQL=false

# ---------------------------------------------------------------------------
# Redis
# ---------------------------------------------------------------------------
REDIS_HOST=localhost
REDIS_PORT=6379
# REDIS_PASSWORD=

# Separate logical databases so flushing the cache cannot destroy sessions or
# rate-limit counters.
REDIS_CACHE_DB=0
REDIS_SESSION_DB=1
REDIS_RATE_LIMIT_DB=2

REDIS_DEFAULT_TTL_SECONDS=300
REDIS_SOCKET_TIMEOUT_SECONDS=5

# The rate limiter runs on every request, so it uses a much shorter timeout and
# a circuit breaker — otherwise a Redis outage adds seconds of latency to every
# request in the system.
REDIS_FAST_PATH_TIMEOUT_SECONDS=0.25
REDIS_CIRCUIT_BREAKER_THRESHOLD=3
REDIS_CIRCUIT_BREAKER_COOLDOWN_SECONDS=10

# ---------------------------------------------------------------------------
# RabbitMQ / Celery
# ---------------------------------------------------------------------------
RABBITMQ_USER=droppilot
RABBITMQ_PASSWORD=droppilot

CELERY_BROKER_URL=amqp://droppilot:droppilot@localhost:5672//
CELERY_RESULT_BACKEND=redis://localhost:6379/3
CELERY_TASK_DEFAULT_QUEUE=default
CELERY_TASK_SOFT_TIME_LIMIT=300
CELERY_TASK_TIME_LIMIT=360
CELERY_WORKER_PREFETCH_MULTIPLIER=1
CELERY_WORKER_MAX_TASKS_PER_CHILD=1000
CELERY_TASK_ACKS_LATE=true

# ---------------------------------------------------------------------------
# Security
# ---------------------------------------------------------------------------
# Signs every JWT. MUST be changed before any deployment — the application
# refuses to start in a deployed environment while this is the placeholder.
#
# Minimum 32 characters, enforced in EVERY environment (RFC 7518 section 3.2 for
# HS256). A shorter key signs and verifies perfectly well and is only weaker,
# so the failure would otherwise be silent.
# Generate with:  python -c "import secrets; print(secrets.token_urlsafe(64))"
SECURITY_SECRET_KEY=insecure-local-development-key-change-me

# --- JWT ---
# HS256 is correct while one service both issues and verifies tokens. Move to
# RS256 when a separate auth service or an edge gateway needs verification-only
# access — sharing a symmetric secret would let them mint tokens.
SECURITY_JWT_ALGORITHM=HS256
SECURITY_JWT_ISSUER=droppilot
SECURITY_JWT_AUDIENCE=droppilot-api
SECURITY_JWT_LEEWAY_SECONDS=10

# Access tokens cannot be revoked before they expire, so this value IS the
# window in which a stolen token remains usable. Keep it short.
SECURITY_ACCESS_TOKEN_TTL_MINUTES=15
SECURITY_REFRESH_TOKEN_TTL_DAYS=30

# --- Password policy ---
# Length dominates every other rule for real strength. Symbols are not required
# by default: forcing them pushes users towards "Password1!" without materially
# raising entropy.
SECURITY_PASSWORD_MIN_LENGTH=12
SECURITY_PASSWORD_MAX_LENGTH=128
SECURITY_PASSWORD_REQUIRE_UPPERCASE=true
SECURITY_PASSWORD_REQUIRE_LOWERCASE=true
SECURITY_PASSWORD_REQUIRE_DIGIT=true
SECURITY_PASSWORD_REQUIRE_SYMBOL=false

# --- Argon2id ---
# OWASP-recommended defaults (19 MiB, 2 iterations, 1 lane). Raise memory first
# if the hardware allows: memory is hardest for an attacker to parallelise.
SECURITY_ARGON2_TIME_COST=2
SECURITY_ARGON2_MEMORY_COST_KIB=19456
SECURITY_ARGON2_PARALLELISM=1

# --- Login throttling ---
# Far stricter than the general API limit: /auth/login is unauthenticated and
# is the highest-value target in the platform. Counted against email AND client
# IP independently — see docs/Authentication.md for why either alone fails.
SECURITY_LOGIN_MAX_ATTEMPTS=5
SECURITY_LOGIN_ATTEMPT_WINDOW_SECONDS=300
SECURITY_LOGIN_LOCKOUT_SECONDS=900

# --- Cookies ---
# Set to false ONLY for local HTTP development; a Secure cookie is not sent over
# plain HTTP, so leaving it true locally silently breaks session refresh.
SECURITY_COOKIE_SECURE=true
SECURITY_COOKIE_SAMESITE=lax
# SECURITY_COOKIE_DOMAIN=
SECURITY_REFRESH_COOKIE_NAME=droppilot_refresh

SECURITY_RATE_LIMIT_ENABLED=true
# Production / shared-IP default. A full Playwright run against a live local
# API exceeds 100 unauthenticated requests per minute (audit A-06 / M13).
# Raise only for e2e or local suite runs — never lower the deployed default:
#   SECURITY_RATE_LIMIT_REQUESTS=1000

# Comma-separated CIDRs whose X-Forwarded-For / CF-Connecting-IP headers may be
# believed. **Blank by default, and that default is the safe one**: with no
# entry every forwarding header is ignored and the socket peer is the identity,
# so a caller reaching the service directly cannot forge one.
#
# Set this to the address the reverse proxy connects FROM, not the address it
# listens on. With a Cloudflare Tunnel the connector runs beside the API and
# arrives over loopback, so the value is the loopback host:
#   SECURITY_TRUSTED_PROXIES=127.0.0.1/32,::1/128
# Behind Nginx in the same compose network, use that network's CIDR.
#
# Leaving this blank behind a proxy is visibly wrong rather than silently
# insecure: every client collapses to the proxy's own address.
#
# This setting is only authoritative if the ASGI server is not making the same
# decision underneath it. Uvicorn parses X-Forwarded-For by default and trusts
# 127.0.0.1 — which is where cloudflared connects from — so every launch path
# in this repository passes `--no-proxy-headers`. Do not remove it, and do not
# use uvicorn's `--forwarded-allow-ips` instead: two proxy authorities that can
# disagree is worse than either one. See docs/PRODUCTION_SECURITY.md section 7.
SECURITY_TRUSTED_PROXIES=
SECURITY_RATE_LIMIT_REQUESTS=100
SECURITY_RATE_LIMIT_WINDOW_SECONDS=60
SECURITY_HSTS_MAX_AGE_SECONDS=31536000

# --- Credential encryption ---
# Encrypts third-party credentials (AliExpress app secrets and OAuth tokens).
# SEPARATE from SECURITY_SECRET_KEY, which signs JWTs. They must differ: a
# signing key can be rotated immediately at the cost of ending every session,
# whereas rotating this one requires re-encrypting stored data first.
#
# Comma-separated, NEWEST FIRST. Decryption tries every key; encryption uses the
# first. That is what makes rotation possible with no downtime — prepend a key,
# re-encrypt in the background, then drop the old one.
#
# Each must be a urlsafe base64-encoded 32-byte Fernet key:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
#
# Empty means credential storage is unavailable: the app starts, but any attempt
# to connect an integration is refused rather than storing a secret in plaintext.
SECURITY_ENCRYPTION_KEYS=

# ---------------------------------------------------------------------------
# AliExpress Open Platform
# ---------------------------------------------------------------------------
# The AliExpress developer application belongs to the PLATFORM OPERATOR, not to
# each tenant. DropPilot registers one application; every seller authorises that
# application through OAuth. A seller does not register their own — requiring
# that would make onboarding impossible.
#
# Leave both blank here. Set the real values in .env, which is gitignored.
# Never commit them.
ALIEXPRESS_APP_KEY=
ALIEXPRESS_APP_SECRET=

# -----------------------------------------------------------------------------
# Shopify (Phase 8) — Partner / custom app credentials for the DropPilot app.
# Per-shop access tokens are stored encrypted in the database after OAuth.
# -----------------------------------------------------------------------------
SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=
# Product publish works with the scopes below. Optional later scopes (require
# Partner Dashboard update + merchant reauthorization — see docs/PRODUCT_SHIPPING.md
# and docs/SHOPIFY_PUBLICATION_RESULT.md):
#   write_publications — Online Store channel publish/unpublish via publications API
#   read_shipping,write_shipping — delivery profile/zone management (not used yet)
SHOPIFY_SCOPES=read_products,write_products,read_inventory,write_inventory,read_orders,read_locations
# Admin API version for new GraphQL paths (shop currency). Shared with REST callers.
# Remaining REST→GraphQL migration debt is tracked in docs/SHOPIFY_API_MODERNISATION.md.
SHOPIFY_API_VERSION=2026-07
SHOPIFY_CALLBACK_URL=http://localhost:8000/api/v1/integrations/shopify/callback
SHOPIFY_FRONTEND_RETURN_URL=http://localhost:3000/settings/integrations
# Must end with /webhooks (per-topic), /webhook (shared singular), or /callback (shared).
# Canonical production preference (logically separate from OAuth GET callback):
#   …/api/v1/integrations/shopify/webhook
# Per-topic alternative when the tunnel forwards the whole API:
#   …/api/v1/integrations/shopify/webhooks
# Temporary path-scoped tunnel fallback only (POST callback is an explicit HMAC
# webhook receiver in code — not a substitute once /webhook is publicly reachable):
#   …/api/v1/integrations/shopify/callback
SHOPIFY_WEBHOOK_CALLBACK_BASE=http://localhost:8000/api/v1/integrations/shopify/webhook
# Partner Dashboard App URL (public installs): {API}/api/v1/integrations/shopify/install
# Cloudflare must forward the full API hostname (preferred) or at least /install + /webhook.

# Application status in the AliExpress developer console: test | production.
# An app in `test` status can only be authorised by allow-listed accounts, so an
# authorization failure that looks like bad credentials is often just this.
ALIEXPRESS_ENVIRONMENT=test

# WARNING: these endpoint defaults have not been verified against a live
# AliExpress account. Confirm them against current developer documentation
# before production use — see docs/ALIEXPRESS_INTEGRATION.md.
ALIEXPRESS_AUTHORIZE_URL=https://api-sg.aliexpress.com/oauth/authorize
ALIEXPRESS_TOKEN_URL=https://api-sg.aliexpress.com/rest/auth/token/create
ALIEXPRESS_REFRESH_URL=https://api-sg.aliexpress.com/rest/auth/token/refresh
ALIEXPRESS_API_BASE_URL=https://api-sg.aliexpress.com/sync

# Must match the value registered in the AliExpress developer console exactly,
# including scheme and any trailing slash. A mismatch is rejected before a code
# is issued, and the error appears on AliExpress's page rather than in our logs.
#
# The registered callback for the current application is:
#   https://api.whiteto.com/api/v1/integrations/aliexpress/callback
# Set that in .env for any environment where the OAuth flow must complete. A
# Cloudflare Tunnel forwards that one path to the local backend; every other
# route on that host returns 404, which is sufficient because AliExpress calls
# nothing else.
#
# The apex whiteto.com is NOT usable here — it serves the Next.js frontend, so
# /api/v1/* returns that application's own 404 page. That is why the callback
# lives on the api subdomain.
#
# The localhost default below only works if the developer console is also
# pointed at localhost.
#
# ALIEXPRESS_REDIRECT_URI is accepted as an alias for the same value, so an
# environment still using the Phase 3 name keeps working. Set
# ALIEXPRESS_CALLBACK_URL, not the alias — the former wins when both are set,
# so a value placed only in the alias is read and discarded.
ALIEXPRESS_CALLBACK_URL=http://localhost:8000/api/v1/integrations/aliexpress/callback
ALIEXPRESS_FRONTEND_RETURN_URL=http://localhost:3000/settings/integrations

ALIEXPRESS_REQUEST_TIMEOUT_SECONDS=15
ALIEXPRESS_CONNECT_TIMEOUT_SECONDS=5
ALIEXPRESS_MAX_RETRIES=3
ALIEXPRESS_RETRY_BACKOFF_SECONDS=1
ALIEXPRESS_RETRY_BACKOFF_MAX_SECONDS=30

# Outbound quota, per tenant. Staying under AliExpress's own limits avoids
# burning quota on requests they would reject anyway.
ALIEXPRESS_RATE_LIMIT_REQUESTS=60
ALIEXPRESS_RATE_LIMIT_WINDOW_SECONDS=60

# Refresh this far ahead of expiry, so a sync is never interrupted mid-run.
ALIEXPRESS_TOKEN_REFRESH_MARGIN_SECONDS=900
# How long an OAuth state token stays valid.
ALIEXPRESS_OAUTH_STATE_TTL_SECONDS=600

# ---------------------------------------------------------------------------
# FX / currency conversion (pricing integrity)
# ---------------------------------------------------------------------------
# Default `unavailable` blocks cross-currency pricing until a real feed is
# configured. Never invent a 1:1 rate when currencies differ.
# Values: unavailable | stub (tests only) | openexchangerates
FX_PROVIDER=unavailable
# FX_API_KEY=
FX_BASE_URL=https://openexchangerates.org/api
FX_TIMEOUT_SECONDS=10
# Freshness window (quote is CURRENT). Separate from Redis retention.
FX_CACHE_TTL_SECONDS=3600
# Redis retention + outer bound for controlled stale fallback.
FX_MAX_STALENESS_SECONDS=21600
# Deprecated: prefer FX_CACHE_TTL_SECONDS
FX_RATE_MAX_AGE_MINUTES=60

# ---------------------------------------------------------------------------
# Logging
# ---------------------------------------------------------------------------
LOG_LEVEL=INFO
# JSON for machines, false for readable local console output.
LOG_JSON_OUTPUT=false
# Rejected outright in deployed environments — request bodies carry customer
# data.
LOG_INCLUDE_REQUEST_BODY=false
LOG_SLOW_REQUEST_MS=1000

# ---------------------------------------------------------------------------
# Object storage (AWS S3)
# ---------------------------------------------------------------------------
S3_BUCKET=droppilot-local
S3_REGION=eu-west-1
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# Point at MinIO or LocalStack for local development; leave unset for real AWS.
# S3_ENDPOINT_URL=http://localhost:9000
S3_PRESIGNED_URL_TTL_SECONDS=3600

# ---------------------------------------------------------------------------
# AI product optimisation (Phase 9)
# ---------------------------------------------------------------------------
# `stub` (default) needs no key and produces deterministic, clearly-fake
# output — see app/ai/stub_provider.py. Selecting any other value here is a
# configuration error until that provider ships; see docs/PHASE_9_PLAN.md.
AI_PROVIDER=stub
# AI_OPENAI_API_KEY=
# AI_ANTHROPIC_API_KEY=
# AI_GOOGLE_API_KEY=
# AI_LOCAL_BASE_URL=
AI_REQUEST_TIMEOUT_SECONDS=30
AI_CONNECT_TIMEOUT_SECONDS=5
AI_MAX_RETRIES=2
# Off by default: platform-global prompts must not be editable by tenant admins
# (audit A-03). Set true only for platform operators or local prompt authoring.
AI_ALLOW_PROMPT_MUTATION=false

# ---------------------------------------------------------------------------
# Frontend build arguments (consumed by Docker Compose)
# ---------------------------------------------------------------------------
# Prefer 127.0.0.1 over localhost when pointing at the published backend port
# (:8000) on Windows — browsers often resolve localhost to IPv6 (::1) while
# Uvicorn may listen on IPv4 only, which shows up as "Could not reach the server".
# Default matches nginx on :80 (same-origin `/api`). See docs/DevelopmentSetup.md
# and audit A-05.
NEXT_PUBLIC_API_URL=http://localhost

# ---------------------------------------------------------------------------
# eBay Developers Program (EBAY-C0 compliance + EBAY-C1 seller OAuth)
# ---------------------------------------------------------------------------
# Platform credentials for DropPilot's own eBay application. NOT merchant-entered:
# there is no UI field for any of these, and none is ever returned by an API.
# Blank here by design — real values belong in the deployment secret store.
#
# sandbox | production. Chooses the Notification API host and nothing else.
EBAY_ENVIRONMENT=production
EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=
EBAY_DEV_ID=
# The **RuName**, not a URL — an opaque identifier the eBay portal issues for a
# redirect URL set, shown there as "RuName (eBay Redirect URL name)". It is what
# goes in the `redirect_uri` OAuth parameter, and eBay resolves it to the Auth
# Accepted / Auth Declined URLs configured against it. Putting an actual URL here
# fails on eBay's own consent page with nothing this application can diagnose.
#
# The URLs to register against the RuName in the portal:
#   Auth accepted:  https://api.whiteto.com/api/v1/integrations/ebay/callback
#   Auth declined:  https://api.whiteto.com/api/v1/integrations/ebay/callback
#   Privacy policy: https://whiteto.com/privacy
# Both accepted and declined point at the same endpoint on purpose: the handler
# distinguishes them by the parameters eBay sends (`code` versus `error`), and a
# second route would be the same code behind a different name.
EBAY_REDIRECT_URI_NAME=
# The exact URL registered in the eBay developer portal, byte for byte. It is
# part of the challenge hash, so a single differing character — including a
# trailing slash — makes endpoint validation fail with no useful error from
# eBay. Never normalised by this application.
EBAY_MARKETPLACE_DELETION_ENDPOINT=https://api.whiteto.com/api/v1/integrations/ebay/marketplace-account-deletion
# 32-80 characters, letters/digits/underscore/hyphen only (eBay's rule, enforced
# at boot). Generate a fresh one when the endpoint is registered; never reuse a
# token that has appeared anywhere outside the secret store.
EBAY_MARKETPLACE_DELETION_VERIFICATION_TOKEN=

# --- EBAY-C1 seller OAuth (all optional; the defaults are the intended values)
#
# Where the merchant's browser lands after consent. Set this to the deployed
# frontend, or the seller returns to localhost after authorizing.
EBAY_FRONTEND_RETURN_URL=https://app.whiteto.com/settings/integrations
# How long a consent attempt stays valid. Short by design: the OAuth `state` is
# a one-time CSRF credential, not a session. 60-3600 seconds.
EBAY_OAUTH_STATE_TTL_SECONDS=600
# Refresh this far ahead of expiry rather than waiting for a 401. eBay's own
# guidance is to refresh reactively; refreshing slightly early instead trades one
# extra token call for never failing a merchant action that would have to be
# retried. 0-3600 seconds.
EBAY_TOKEN_REFRESH_MARGIN_SECONDS=300
EBAY_REQUEST_TIMEOUT_SECONDS=20
EBAY_CONNECT_TIMEOUT_SECONDS=5
#
# NOTE: `SECURITY_ENCRYPTION_KEYS` is a hard requirement for EBAY-C1, not an
# optional hardening step. Seller access and refresh tokens are stored encrypted,
# and `connect` refuses to start a consent flow when no key is configured —
# discovering the platform cannot store a token *after* a seller has granted
# consent would waste their time and leave a live credential with nowhere safe
# to go.
